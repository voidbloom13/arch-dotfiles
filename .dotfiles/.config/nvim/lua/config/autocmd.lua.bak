-- Resets comments hl settings after theme change
local function on_theme_change()
  vim.api.nvim_set_hl(0, "Comment", { italic = true, fg = "#ff00ff" })
end

vim.api.nvim_create_autocmd("ColorScheme", {
  desc = "Execute command after theme change",
  callback = on_theme_change
})

vim.api.nvim_create_autocmd("User", {
  pattern = "NvChadReload",
  desc = "Execute command after NvChad theme reload",
  callback = on_theme_change
})
